# Tether environment variables
#
# Tether runs with ZERO configuration out of the box: with no variables set it
# uses a durable in-process memory store, which is perfect for local demos.
#
# To persist memories in Supabase Postgres (recommended for a deployed demo),
# run supabase/migrations/0001_init.sql in the Supabase SQL editor and set:

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Server-only service role key. NEVER expose this to the browser and never
# commit it. Tether only ever reads it inside route handlers.
SUPABASE_SERVICE_ROLE_KEY=
